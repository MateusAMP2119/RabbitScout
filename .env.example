# RabbitMQ Connection
# The host and port of the RabbitMQ Management API (default: localhost:15672)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=15672
RABBITMQ_PROTOCOL=http

# Optional: API request timeout in milliseconds (default: 15000)
# RABBITMQ_API_TIMEOUT_MS=15000

# Optional: force the session cookie's Secure attribute on or off.
# By default RabbitScout detects HTTPS per-request (x-forwarded-proto aware),
# so you only need this if a proxy hides the original protocol.
# COOKIE_SECURE=true

# Note: Username and password are no longer configured here.
# Each user authenticates with their own RabbitMQ credentials via the login page.

# Optional: record dashboard metrics into a SQLite file, kept past the broker's 24h window.
# Recording is off unless METRICS_DB is set. Mount a volume at its folder to keep history
# across deploys. The user needs the RabbitMQ "monitoring" tag.
# METRICS_DB=/data/metrics.db
# METRICS_USERNAME=rabbitscout-metrics
# METRICS_PASSWORD=
# METRICS_INTERVAL_SECONDS=5
# METRICS_RETENTION_DAYS=30
